{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "1.0.0",
  "description": "Smart tab groups, bookmark manager, tab library, duplicate finder and customizable themes. Local-first and private.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "storage",
    "history",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_embed",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "TabVault",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/dashboard/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
